{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ion OS",
  "version": "0.0.0",
  "identifier": "com.ionos.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ion OS",
        "width": 980,
        "height": 680,
        "minWidth": 540,
        "minHeight": 560,
        "resizable": true
      },
      {
        "label": "quick-capture",
        "title": "Ion Quick Capture",
        "width": 440,
        "height": 230,
        "center": true,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self'; style-src 'self' 'unsafe-inline'",
      "devCsp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns"],
    "externalBin": ["binaries/ion-api"],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
